        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#33FFFFFF" android:layout_gravity="center" android:translationY="90dp"/>
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#33FFFFFF" android:layout_gravity="center" android:translationX="-110dp"/>
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#33FFFFFF" android:layout_gravity="center" android:translationX="110dp"/>
