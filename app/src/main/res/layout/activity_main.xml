        <TextView android:id="@+id/recipeDropdown" android:layout_width="132dp" android:layout_height="38dp" android:text="Classic Chrome ∨" android:background="@drawable/pill_dark_border" android:textColor="#FFFFFF" android:fontFamily="monospace" android:gravity="center" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/recipeLabel" android:layout_marginStart="16dp" android:layout_marginTop="6dp"/>
        <View android:id="@+id/shutter" android:layout_width="76dp" android:layout_height="76dp" android:background="@drawable/white_circle" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" android:layout_marginEnd="16dp" android:layout_marginTop="14dp"><TextView android:text="POST PROCESS" android:textColor="#888888" android:fontFamily="monospace" android:textSize="10sp"/><TextView android:id="@+id/postProcessBtn" android:layout_width="88dp" android:layout_height="38dp" android:text="AV  □" android:background="@drawable/pill_dark_border" android:textColor="#FFF" android:fontFamily="monospace" android:gravity="center" android:layout_marginTop="6dp"/></LinearLayout>
