        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/pill_dark" android:padding="10dp" android:layout_gravity="bottom|start" android:layout_margin="10dp" android:orientation="vertical"><TextView android:id="@+id/exposureInfo" android:text="f/2.0  1/250s  A-ISO 400" android:textColor="#FFFFFF" android:fontFamily="monospace" android:textSize="12sp"/><TextView android:id="@+id/awbInfo" android:text="AWB  ◫ Porträtt" android:textColor="#CFCFD4" android:fontFamily="monospace" android:textSize="11sp"/></LinearLayout>
        <TextView android:id="@+id/aspectInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2:3 AUTO" android:background="@drawable/pill_dark" android:textColor="#FFFFFF" android:fontFamily="monospace" android:textSize="10sp" android:padding="8dp" android:layout_gravity="bottom|end" android:layout_margin="10dp"/>
        <CheckBox android:id="@+id/liveCheckBox" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:id="@+id/infoNumber" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:id="@+id/infoName" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:id="@+id/infoSim" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:id="@+id/saveToast" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content"/><FrameLayout android:id="@+id/resultOverlay" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp"><ImageView android:id="@+id/resultImage" android:layout_width="match_parent" android:layout_height="match_parent"/><com.google.android.material.button.MaterialButton android:id="@+id/retakeBtn" android:layout_width="wrap_content" android:layout_height="wrap_content"/><com.google.android.material.button.MaterialButton android:id="@+id/saveBtn" android:layout_width="wrap_content" android:layout_height="wrap_content"/></FrameLayout><ScrollView android:id="@+id/recipeScroll" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp"><LinearLayout android:id="@+id/recipeListContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/></ScrollView>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/bottomBar" android:layout_width="0dp" android:layout_height="116dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
